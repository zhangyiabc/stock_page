{
  // ═══════════════════════════════════════════════════
  // A 股投资分析系统 - OpenClaw 配置
  // ═══════════════════════════════════════════════════

  // ─── Agent 配置 ───
  "agents": {
    "defaults": {
      "model": "kimi-k2.5",
      "userTimezone": "Asia/Shanghai",
      "heartbeat": {
        "every": "15m",
        "target": "feishu",
        "activeHours": {
          "start": "09:15",
          "end": "15:15",
          "timezone": "Asia/Shanghai"
        },
        "lightContext": false
      }
    },
    "list": [
      {
        "id": "coordinator",
        "name": "盘古 · 协调者",
        "default": true,
        "workspace": "~/.openclaw/workspace-coordinator",
        "agentDir": "~/.openclaw/agents/coordinator/agent",
        "model": "kimi-k2.5",
        "identity": { "name": "盘古" },
        "groupChat": {
          "mentionPatterns": ["@盘古", "@pangu", "@PanGu"]
        },
        "heartbeat": {
          "every": "15m",
          "target": "feishu",
          "prompt": "读取 HEARTBEAT.md，检查是否在 A 股交易时间。如果在交易时间，执行心跳监控流程：1) 向 portfolio-mgr 获取全体持仓股票列表 2) 向 researcher 检查舆情变化 3) 如有变化通知相关投资者。如果不在交易时间，回复 HEARTBEAT_OK。",
          "activeHours": {
            "start": "09:15",
            "end": "15:15",
            "timezone": "Asia/Shanghai"
          }
        }
      },
      {
        "id": "researcher",
        "name": "朝闻 · 研究员",
        "workspace": "~/.openclaw/workspace-researcher",
        "agentDir": "~/.openclaw/agents/researcher/agent",
        "model": "qwen3-max-2026-01-23",
        "identity": { "name": "朝闻" },
        "tools": {
          "allow": [
            "exec", "read", "write", "edit",
            "sessions_list", "sessions_history", "sessions_send"
          ]
        }
      },
      {
        "id": "strategist",
        "name": "鬼谷 · 策略师",
        "workspace": "~/.openclaw/workspace-strategist",
        "agentDir": "~/.openclaw/agents/strategist/agent",
        "model": "kimi-k2.5",
        "identity": { "name": "鬼谷" },
        "tools": {
          "allow": [
            "read", "write",
            "sessions_list", "sessions_history", "sessions_send"
          ],
          "deny": ["exec", "browser", "canvas", "nodes"]
        }
      },
      {
        "id": "portfolio-mgr",
        "name": "算盘 · 持仓管家",
        "workspace": "~/.openclaw/workspace-portfolio-mgr",
        "agentDir": "~/.openclaw/agents/portfolio-mgr/agent",
        "model": "qwen3.5-plus",
        "identity": { "name": "算盘" },
        "tools": {
          "allow": [
            "exec", "read", "write",
            "sessions_list", "sessions_history", "sessions_send"
          ],
          "deny": ["browser", "canvas", "nodes"]
        }
      }
    ]
  },

  // ─── Agent 间通信 ───
  "tools": {
    "agentToAgent": {
      "enabled": true,
      "allow": ["coordinator", "researcher", "strategist", "portfolio-mgr"]
    },
    "sessions": {
      "visibility": "agent"
    }
  },

  // ─── Bindings: 飞书群消息路由到协调者 ───
  "bindings": [
    {
      "agentId": "coordinator",
      "match": {
        "channel": "feishu",
        "peer": { "kind": "group", "id": "oc_XXXXXXXX" }
      }
    },
    {
      "agentId": "coordinator",
      "match": {
        "channel": "feishu",
        "accountId": "*"
      }
    }
  ],

  // ─── 飞书渠道配置 ───
  "channels": {
    "feishu": {
      "enabled": true,
      "dmPolicy": "pairing",
      "streaming": true,
      "blockStreaming": true,
      "groupPolicy": "allowlist",
      "groupAllowFrom": ["oc_XXXXXXXX"],
      "groups": {
        "oc_XXXXXXXX": {
          "requireMention": true,
          "enabled": true
        }
      },
      "accounts": {
        "main": {
          "appId": "cli_XXXXXXXX",
          "appSecret": "XXXXXXXX",
          "botName": "盘古"
        }
      }
    }
  },

  // ─── 定时任务 ───
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 2,
    "sessionRetention": "48h"
  },

  // ─── MCP Server ───
  "mcpServers": {
    "stock-data-mcp": {
      "command": "python",
      "args": ["mcp-servers/stock-data-mcp/server.py"],
      "transport": "stdio"
    },
    "news-sentiment-mcp": {
      "command": "python",
      "args": ["mcp-servers/news-sentiment-mcp/server.py"],
      "transport": "stdio"
    },
    "portfolio-db-mcp": {
      "command": "python",
      "args": ["mcp-servers/portfolio-db-mcp/server.py"],
      "transport": "stdio"
    }
  },

  // ─── 消息配置 ───
  "messages": {
    "groupChat": {
      "mentionPatterns": ["@盘古", "@pangu"]
    }
  }
}
