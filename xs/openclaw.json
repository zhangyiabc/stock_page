{
  "agents": {
    "list": [
      {
        "id": "coordinator",
        "name": "总调度",
        "default": true,
        "workspace": "./workspace-coordinator",
        "agentDir": "~/.openclaw/agents/coordinator/agent",
        "model": "qwen/qwen3-max-2026-01-23",
        "tools": {
          "alsoAllow": ["lobster"]
        }
      },
      {
        "id": "planner",
        "name": "策划大师",
        "workspace": "./workspace-planner",
        "agentDir": "~/.openclaw/agents/planner/agent",
        "model": "qwen/qwen3.5-plus"
      },
      {
        "id": "writer",
        "name": "写手",
        "workspace": "./workspace-writer",
        "agentDir": "~/.openclaw/agents/writer/agent",
        "model": "openrouter/moonshotai/kimi-k2.5"
      },
      {
        "id": "editor",
        "name": "编辑",
        "workspace": "./workspace-editor",
        "agentDir": "~/.openclaw/agents/editor/agent",
        "model": "zai/glm-5"
      },
      {
        "id": "memory-keeper",
        "name": "记忆管家",
        "workspace": "./workspace-memory",
        "agentDir": "~/.openclaw/agents/memory-keeper/agent",
        "model": "minimax/MiniMax-M2.5"
      }
    ],
    "defaults": {
      "compaction": {
        "model": "zai/glm-4.7",
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 6000,
          "systemPrompt": "会话即将压缩。注意数据归属：只有 memory-keeper 可以写入 memory/ 目录下的角色、大纲、伏笔等文件。coordinator 只能写入 progress.md。其他 agent 不写任何文件。",
          "prompt": "如果你是 coordinator，将当前流水线进度摘要写入 memory/plot/progress.md；如果你是 memory-keeper，将关键的角色变化和伏笔信息写入对应 memory 文件；如果你是其他 agent（planner/writer/editor），回复 NO_REPLY。"
        }
      },
      "subagents": {
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 5,
        "maxConcurrent": 8,
        "runTimeoutSeconds": 1800,
        "archiveAfterMinutes": 120,
        "model": "minimax/MiniMax-M2.5"
      },
      "memorySearch": {
        "provider": "qwen",
        "model": "qwen3-coder-plus",
        "query": {
          "hybrid": {
            "enabled": true,
            "vectorWeight": 0.7,
            "textWeight": 0.3,
            "candidateMultiplier": 4,
            "mmr": {
              "enabled": true,
              "lambda": 0.7
            },
            "temporalDecay": {
              "enabled": false
            }
          }
        },
        "cache": {
          "enabled": true,
          "maxEntries": 50000
        }
      },
      "bootstrapMaxChars": 25000,
      "bootstrapTotalMaxChars": 180000
    }
  },

  "bindings": [
    { "agentId": "coordinator", "match": { "channel": "telegram" } },
    { "agentId": "coordinator", "match": { "channel": "whatsapp" } },
    { "agentId": "coordinator", "match": { "channel": "discord" } }
  ],

  "tools": {
    "agentToAgent": {
      "enabled": true,
      "allow": ["coordinator", "planner", "writer", "editor", "memory-keeper"]
    },
    "alsoAllow": ["lobster"]
  },

  "session": {
    "dmScope": "per-channel-peer",
    "reset": {
      "mode": "idle",
      "idleMinutes": 480
    },
    "maintenance": {
      "mode": "enforce",
      "pruneAfter": "90d",
      "maxEntries": 2000,
      "rotateBytes": "20mb"
    }
  },

  "memory": {
    "backend": "qmd",
    "citations": "auto",
    "qmd": {
      "includeDefaultMemory": true,
      "searchMode": "query",
      "update": {
        "interval": "3m",
        "debounceMs": 10000
      },
      "limits": {
        "maxResults": 10,
        "maxSnippetChars": 2000,
        "timeoutMs": 5000
      }
    }
  },

  "models": {
    "mode": "merge",
    "providers": {
      "qwen": {
        "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "apiKey": "${QWEN_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen3.5-plus",
            "name": "Qwen3.5-Plus",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 1000000,
            "maxTokens": 16384
          },
          {
            "id": "qwen3-max-2026-01-23",
            "name": "Qwen3-Max (2026-01-23)",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 256000,
            "maxTokens": 16384
          },
          {
            "id": "qwen3-coder-plus",
            "name": "Qwen3-Coder-Plus",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 256000,
            "maxTokens": 16384
          },
          {
            "id": "qwen3-coder-next",
            "name": "Qwen3-Coder-Next",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 256000,
            "maxTokens": 8192
          }
        ]
      },
      "zai": {
        "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
        "apiKey": "${ZAI_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "glm-5",
            "name": "GLM-5",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 200000,
            "maxTokens": 16384
          },
          {
            "id": "glm-4.7",
            "name": "GLM-4.7",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 200000,
            "maxTokens": 16384
          }
        ]
      },
      "minimax": {
        "baseUrl": "https://api.minimaxi.com/anthropic",
        "apiKey": "${MINIMAX_API_KEY}",
        "api": "anthropic-messages",
        "models": [
          {
            "id": "MiniMax-M2.5",
            "name": "MiniMax M2.5",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 200000,
            "maxTokens": 16384
          }
        ]
      }
    }
  },

  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 2,
    "sessionRetention": "48h",
    "runLog": {
      "maxBytes": "2mb",
      "keepLines": 2000
    }
  },

  "plugins": {
    "entries": {
      "llm-task": { "enabled": true },
      "open-prose": { "enabled": true }
    }
  },

  "skills": {
    "load": {
      "extraDirs": ["./shared-skills"],
      "watch": true,
      "watchDebounceMs": 500
    }
  }
}
