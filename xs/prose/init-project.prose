# 小说项目初始化流水线
# 用法: /prose run init-project.prose

input title: "小说名称"
input genre: "小说类型（玄幻/科幻/悬疑/历史/都市/其他）"
input premise: "核心设定或故事前提（一段话描述）"
input target_length: "目标总字数（如：100万字）"

agent planner:
  model: qwen/qwen3.5-plus
  prompt: "你是网文策划大师。精通爽点设计、节奏控制、钩子设计。根据用户的题材和设定，设计能让读者停不下来的世界观和故事架构。"

agent memory-keeper:
  model: minimax/MiniMax-M2.5
  prompt: "你是小说数据库管理员。将设定信息结构化后写入对应的 memory 文件。"

# Step 1: 世界观设计
worldbuilding = session: planner
  prompt: |
    为小说《{title}》设计世界观。
    类型：{genre}
    核心设定：{premise}
    目标字数：{target_length}
    
    请设计：
    1. 世界观总纲（社会结构、核心规则、文化背景）
    2. 力量/能力体系（等级、分类、限制、禁忌）
    3. 地理设定（主要地点、距离关系）
    4. 势力/组织设定（主要势力及关系）
    5. 背景历史（影响当前故事的历史事件）

# Step 2: 角色设计
characters = session: planner
  prompt: |
    为小说《{title}》设计主要角色。
    
    角色设计公式：**功能 + 欲望 + 特点 + 关系 + 变化**
    
    **主角设计**（必须通过四要素检查）：
    1. 有欲望：他想要什么？（复仇/变强/活下去/登顶/改命...）
    2. 有特点：最突出的 1 个行为/性格特点是什么？不要空标签，要具体（"嘴毒但关键时刻护短"而非"高冷"）
    3. 有优势：金手指是什么？必须有持续开发空间
    4. 有代入感：读者为什么想成为他/她，或想看他/她翻盘
    5. 有矛盾感：什么反差让他像个活人而不是标签？（明明很强却极度自卑/表面冷漠实则最怕失去）
    6. 有缺点/代价：太冲动/太多疑/太执念/力量使用有代价——强得让人想看，难得让人担心
    
    **配角设计**（3-5个核心配角，每个必须回答八问）：
    对每个配角明确：
    1. 他是谁？
    2. 他想得到什么？（核心欲望，没有欲望的配角会变成工具人）
    3. 他最怕失去什么？
    4. 他最明显的特点是什么？（1个最突出的强特点，不要同时塞太多标签）
    5. 他和主角是什么关系？（从利益/情感/立场/观念四个维度设计张力）
    6. 他第一次出场要起什么作用？（给主角制造阻碍/揭开设定/推动感情线/带入下一阶段）
    7. 他会制造什么冲突或提供什么帮助？
    8. 他最终会变成什么样？（变化方向：从轻视到认可/从利用到伙伴/黑化等）
    
    配角必须有矛盾感设计（嘴硬心软/表面正派实际算计/看着温柔骨子里极狠），避免扁平。
    
    **反派设计**（主要反派）：
    - 必须有真实欲望（不是纯坏，他真的想得到什么）
    - 有自己的行为逻辑（不是随机发疯，符合立场和利益）
    - 能对主角构成压力（能力/资源/身份/智谋至少占一项优势）
    - 能逼出主角的变化（让主角付代价、做选择、暴露弱点）
    - 反派太蠢，主角赢了也不爽
    
    **人物关系图谱**：画出利益/情感/立场三层关系
    
    **对话风格区分**：每个角色的说话方式必须有明确区分（语言节奏/用词习惯/情绪表达），列出每个角色的 1-2 句典型台词示例
    
    **必须避免的错误**：
    - 只有标签没有动机（"高冷校花"太空，为什么高冷？）
    - 只有设定没有功能（设定很多但对剧情没用 = 白设定）
    - 所有人说话都一样
    - 普通配角强行复杂（清晰好记有用有戏就够了）
  context: { worldbuilding }

# Step 3: 总大纲
outline = session: planner
  prompt: |
    为小说《{title}》设计总大纲。
    目标字数：{target_length}
    
    请设计：
    1. 核心卖点（一句话说明这本书的核心吸引力）
    2. 核心情绪（本书提供的主情绪：热血/爽/甜/虐/悬疑）
    3. 多卷结构，每卷必须包含：
       - 卷目标（本卷主角要达成什么）
       - 卷反派（本卷核心对手）
       - 卷冲突（主要矛盾）
       - 卷高潮（最精彩的大场面）
       - 卷收获（主角拿到什么——实力/地位/关系/信息）
    4. 爽点路线图：全书大爽点的时间分布
    5. 主要伏笔网络（至少10条贯穿全书的伏笔线）
    6. 前10章的详细章节规划（开篇设计是生死线）
    
    开篇要求（前3章）：
    - 第1章直接上冲突，不做冗长世界观铺垫
    - 前3章必须让读者知道：主角是谁、遇到什么麻烦、有什么特别、为什么值得继续看
    - 采用高效开头模式：危机开局/反差开局/高概念开局/名场面开局
    - 金手指最迟第3章出现或暗示
    
    节奏要求：
    - 小爽点不断（每1-2章推进感）
    - 每3-5章一个小高潮
    - 每15-20章一个大高潮
    - 不能连续3章无爽点/无推进
    - 铺垫不能太长——十几章还没进入主线就是危险
    - 高潮后不能回落太久
    - 伏笔回收周期不超过30章
    
    全书推进核心循环：
    遇到问题 → 增压 → 找机会 → 翻盘 → 收益 → 更大问题
  context: { worldbuilding, characters }

# Step 4: 持久化所有设定
parallel:
  session: memory-keeper
    prompt: |
      将以下世界观设定写入对应文件：
      - memory/world/worldbuilding.md
      - memory/world/magic-system.md
      - memory/world/geography.md
      - memory/world/factions.md
      - memory/world/history.md
      如果文件已存在，按照已有的结构模板填充内容。
      如果文件不存在，按照 AGENTS.md 中规定的文件规范格式创建文件并填入内容。
    context: { worldbuilding }

  session: memory-keeper
    prompt: |
      将以下角色设定写入对应文件：
      - 每个角色创建独立文件 memory/characters/{拼音}.md
      - 更新 memory/characters/character-index.md
      - 创建 memory/characters/relationships.md
      按照 AGENTS.md 中规定的角色文件规范格式。文件不存在时直接创建。
    context: { characters }

  session: memory-keeper
    prompt: |
      将以下大纲写入对应文件：
      - memory/plot/master-outline.md（总大纲）
      - 为每卷创建 memory/plot/arc-{卷名}.md
      - 初始化 memory/plot/foreshadowing.md（填入规划的伏笔）
      - 初始化 memory/plot/chapter-log.md（空索引）
      如果文件已存在，按照已有的结构填充。如果文件不存在，直接创建。
    context: { outline }

# Step 5: 设置文风
style_guide = session: planner
  prompt: |
    根据小说类型和风格需求，制定文风指南。
    小说类型：{genre}
    
    请确定：
    1. 人称视角
    2. 叙事时态
    3. 整体基调
    4. 语言风格
    5. 各场景类型的节奏规范
    6. 2-3段风格范例文本（分别对应动作场景、情感场景、日常对话）
    
    注意：禁用词汇表、句式反模式、每章自检清单等通用规范已在 style-guide.md 模板中预置，不需要重复输出。只需要输出本项目特有的风格设定。
  context: { worldbuilding, characters }

# Step 6: 持久化文风指南（写入 memory-keeper 的唯一权威源）
session: memory-keeper
  prompt: |
    将以下文风指南写入 memory/style/style-guide.md。
    
    写入规则：
    - 保留文件中已有的通用规范部分（AI味检测词汇黑名单、句式反模式、每章自检清单等）
    - 将 planner 产出的项目特有设定填入对应的待填区域：
      - "基础风格"段落：填入人称视角、叙事时态、整体基调、语言风格、参考作家
      - "文风范例"段落：填入动作/情感/对话的范例文本
    - 不要覆盖已有的禁用词汇表和限用词汇表
  context: { style_guide }

session "项目《{title}》初始化完成。世界观、角色、大纲、文风指南均已创建并持久化。可以开始写第一章了。"
